# ═══════════════════════════════════════════════════════
# HezCast Engine — Environment Variables
# Tinlance Limited | Apache 2.0
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────
DB_PASSWORD=change_me_strong_password

# ── LLM API Keys (fallback chain) ─────────────────────
# Primary: Claude Sonnet
CLAUDE_API_KEY=your_claude_api_key

# Fallback 1: GPT-4o
OPENAI_API_KEY=sk-...

# Fallback 2: Ollama (local — no key needed)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# ── Asset APIs ─────────────────────────────────────────
# Pexels (free tier: 200 req/hour)
# Get key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key

# ── Storage ────────────────────────────────────────────
# Phase 1: local disk (leave blank)
# Phase 2: Backblaze B2 (already in your stack)
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=hezcast-outputs
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# ── Observability ──────────────────────────────────────
SENTRY_DSN=
POSTHOG_API_KEY=

# ── App Config ─────────────────────────────────────────
ENVIRONMENT=development   # development | production
LOG_LEVEL=INFO

# ── API Security ───────────────────────────────────────
# Auto-generated on first run. Override to set fixed key.
ADMIN_API_KEY=

# ── Port Config ────────────────────────────────────────
# API runs on 8503 (alongside trading bot on 8502)
API_PORT=8503

# ── Telegram Publisher ─────────────────────────────────
# Get bot token from @BotFather on Telegram
# Create channel → add bot as admin → get chat ID from:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_channel_username

# ── LemonSqueezy Billing ───────────────────────────────
# Get from app.lemonsqueezy.com → Settings → Webhooks
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret
LEMONSQUEEZY_STORE_SLUG=hezcast
# Variant IDs from your LemonSqueezy store
LS_VARIANT_CREDITS_50=your_variant_id_50
LS_VARIANT_CREDITS_100=your_variant_id_100
# Plan variant IDs
LS_VARIANT_STARTER_MONTHLY=your_starter_monthly_id
LS_VARIANT_PRO_MONTHLY=your_pro_monthly_id
LS_VARIANT_AGENCY_MONTHLY=your_agency_monthly_id

# ── NOWPayments Crypto Payments ────────────────────────────────
# Get from nowpayments.io → My Account → API Keys
NOWPAYMENTS_API_KEY=your_api_key
# Get from nowpayments.io → My Account → IPN Settings → Secret
NOWPAYMENTS_IPN_SECRET=your_ipn_secret
# IPN callback URL (register this in NOWPayments dashboard)
NOWPAYMENTS_IPN_URL=https://api.hezcast.com/billing/nowpayments/webhook

# ── Database (External / Neon) ──────────────────────────────
# Get from neon.tech → Your project → Connection Details
# Format: postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://hezcast_app:password@localhost:5432/hezcast

# ── App Domain ──────────────────────────────────────────────
# Your production domain
DOMAIN=hezcast.com
ENVIRONMENT=production
